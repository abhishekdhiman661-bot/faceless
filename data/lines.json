{
 "duration": 45.081,
 "voice": "am_michael",
 "speed": 1.1,
 "lines": [
  {
   "i": 0,
   "text": "In nineteen sixty-four, an athlete mailed himself home in a wooden box.",
   "start": 0.25,
   "end": 4.724
  },
  {
   "i": 1,
   "text": "Just to avoid paying for a plane ticket.",
   "start": 4.884,
   "end": 7.076
  },
  {
   "i": 2,
   "text": "See, Reg was stranded in London with zero dollars,",
   "start": 7.236,
   "end": 10.326
  },
  {
   "i": 3,
   "text": "and a flight back home cost three hundred pounds,",
   "start": 10.707,
   "end": 13.386
  },
  {
   "i": 4,
   "text": "which he definitely didn't have.",
   "start": 13.767,
   "end": 15.185
  },
  {
   "i": 5,
   "text": "So he built a five foot wooden crate,",
   "start": 15.345,
   "end": 17.285
  },
  {
   "i": 6,
   "text": "labelled it paint,",
   "start": 17.765,
   "end": 18.555
  },
  {
   "i": 7,
   "text": "and climbed inside with some canned food and a pillow.",
   "start": 18.995,
   "end": 22.048
  },
  {
   "i": 8,
   "text": "He shipped the box cash on delivery,",
   "start": 22.208,
   "end": 24.098
  },
  {
   "i": 9,
   "text": "meaning he didn't have to pay a single dime upfront.",
   "start": 24.578,
   "end": 27.162
  },
  {
   "i": 10,
   "text": "For sixty-three hours,",
   "start": 27.322,
   "end": 28.582
  },
  {
   "i": 11,
   "text": "he flew across three continents,",
   "start": 28.932,
   "end": 30.602
  },
  {
   "i": 12,
   "text": "mostly upside down in freezing cargo holds.",
   "start": 31.002,
   "end": 33.951
  },
  {
   "i": 13,
   "text": "When the crate finally touched down in Australia,",
   "start": 34.111,
   "end": 36.511
  },
  {
   "i": 14,
   "text": "Reg waited for the handlers to walk away,",
   "start": 37.011,
   "end": 39.301
  },
  {
   "i": 15,
   "text": "popped the wooden latch open,",
   "start": 39.741,
   "end": 41.081
  },
  {
   "i": 16,
   "text": "and casually strolled right out of the airport.",
   "start": 41.521,
   "end": 43.931
  }
 ]
}